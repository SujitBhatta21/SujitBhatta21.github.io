<div class="col">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img %}
        <div style="height: 180px; overflow: hidden;">
          {%
            include figure.liquid
            loading="eager"
            path=project.img
            sizes = "250px"
            alt="project thumbnail"
            class="card-img-top"
            style="width: 100%; height: 180px; object-fit: cover;"
          %}
        </div>
      {% endif %}
      <div class="card-body" style="display: flex; flex-direction: column;">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        {% if project.tech %}
          <div style="margin-top: auto; display: flex; flex-direction: row; justify-content: center; align-items: center; gap: 8px; padding-top: 10px; flex-wrap: wrap;">
            {% for icon in project.tech %}
              <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/{{ icon }}.svg" alt="{{ icon }}" title="{{ icon | split: '/' | first }}" style="width: 28px !important; height: 28px; display: inline-block; flex-shrink: 0;"/>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </a>
</div>
